# Collection of aliases for git commands

export alias g   = git                           # Git
export alias ga  = git add --all                 # Git add all
export alias gap = git apply                     # Git apply
export alias gs  = git status                    # Git status
export alias gb  = git branch                    # Git branch
export alias gc  = git checkout                  # Git checkout
export alias gcb = git checkout -b               # Git checkout branch
export alias gcl = git clone                     # Git clone
export alias gcm = git commit -v                 # Git commit
export alias gm  = git merge                     # Git merge
export alias gmt = git mergetool --tool=nvimdiff # Git mergetool
