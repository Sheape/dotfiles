# Collection of aliases for cargo commands

export alias c    = cargo                 # Cargo
export alias cr   = cargo run             # Cargo run
export alias crr  = cargo run --release   # Cargo run (release)
export alias cb   = cargo build           # Cargo build
export alias cbr  = cargo build --release # Cargo build (release)
export alias ct   = cargo test            # Cargo test
export alias ce   = cargo run --example   # Cargo run examples
export alias ca   = cargo add             # Cargo add dependency
export alias ccl  = cargo clean           # Cargo clean
export alias cdoc = cargo doc             # Cargo doc
